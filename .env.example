# ───────── Base de datos (Supabase en producción) ─────────
# Pooler (puerto 6543, pgbouncer) para la app y conexión directa (5432) para migraciones.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ───────── Sitio ─────────
SITE_URL="https://estratec.org"

# ───────── Seguridad ─────────
# Cadena aleatoria larga (>= 32 caracteres): openssl rand -base64 48
AUTH_SECRET=""

# ───────── Correo (Resend) ─────────
# Sin RESEND_API_KEY los correos se imprimen en consola (solo desarrollo).
RESEND_API_KEY=""
# Remitente verificado en Resend, p. ej. "Estratec <no-responder@estratec.org>"
MAIL_FROM="Estratec <no-responder@estratec.org>"

# ───────── Primer administrador (npm run admin:create) ─────────
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""
