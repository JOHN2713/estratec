# ───────── Base de datos (Supabase en producción) ─────────
# Pooler (puerto 6543, pgbouncer) para la app y conexión directa (5432) para migraciones.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ───────── Sitio ─────────
SITE_URL="https://estratec.org"

# ───────── Seguridad ─────────
# Cadena aleatoria larga (>= 32 caracteres): openssl rand -base64 48
AUTH_SECRET=""

# ───────── Correo ─────────
# Opción A (actual): Gmail por SMTP con contraseña de aplicación de Google.
# Si SMTP_* está definido, tiene prioridad sobre Resend.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="estratecorg2025@gmail.com"
SMTP_PASS=""   # contraseña de aplicación de 16 caracteres (sin espacios)
# Con Gmail, MAIL_FROM debe usar la misma cuenta: "Estratec <estratecorg2025@gmail.com>"

# Opción B (cuando tengan dominio verificado): Resend. Deja SMTP_* vacíos para usarla.
# Sin RESEND_API_KEY los correos se imprimen en consola (solo desarrollo).
RESEND_API_KEY=""
# Remitente verificado en Resend, p. ej. "Estratec <no-responder@estratec.org>"
MAIL_FROM="Estratec <no-responder@estratec.org>"

# ───────── Primer administrador (npm run admin:create) ─────────
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""
